{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Server (Dev)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/index.js",
      "env": {
        "NODE_ENV": "development"
      },
      "restart": true
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run Current Test File",
      "skipFiles": ["<node_internals>/**"],
      "program": "${file}"
    }
  ]
}
